# Postgres connection used by the running app (pooled URL on Neon/Vercel)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=verify-full
# Direct (non-pooled) URL used by `prisma migrate`
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=verify-full
# Postgres schema the integration tests create and reset (never "public")
TEST_DATABASE_SCHEMA=fieldnote_test

# Origins allowed to make state-changing requests (comma-separated). Required in production, e.g. https://fieldnote.example.org
APP_ORIGIN=

# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-at-least-32-random-characters

# AI extraction: gemini | groq | none. Leave keys empty to use the rule-based fallback.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
AI_TIMEOUT_MS=8000
# Encrypts AI provider keys that administrators save on the AI providers page. Generate with: openssl rand -base64 48
# Optional: if empty, a key is derived from SESSION_SECRET, and rotating SESSION_SECRET then means re-entering those keys.
AI_KEYS_SECRET=

# Production seed only: both required, password must be 12+ characters and not the demo password
ADMIN_EMAIL=
ADMIN_PASSWORD=
